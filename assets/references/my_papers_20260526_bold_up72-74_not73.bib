issn = {2318-0331},
journal = {RBRH},
keywords = {basin of canoas,commons attribution,corretamente citado,distribui{\c{c}}{\~{a}}o e reprodu{\c{c}}{\~{a}}o,efic{\'{a}}cia da arquitetura mlp,em modo closed-loop para,em qualquer meio,este {\'{e}} um artigo,garson algorithm,hidrol{\'{o}}gico,o trabalho original seja,open access,publicado em acesso aberto,que permite uso,rainfall-runoff model,sem restri{\c{c}}{\~{o}}es desde que,simula{\c{c}}{\~{a}}o de um sistema,sob a licen{\c{c}}a creative},
month = {oct},
number = {4},
pages = {821--831},
title = {{Efic{\'{a}}cia da arquitetura MLP em modo closed-loop para simula{\c{c}}{\~{a}}o de um Sistema Hidrol{\'{o}}gico}},
url = {http://www.scielo.br/scielo.php?script=sci{\_}arttext{\&}pid=S2318-03312016000400821{\&}lng=pt{\&}tlng=pt},
volume = {21},
